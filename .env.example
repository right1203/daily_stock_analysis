# ===================================
# KR/US 주식 분석 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# ===================================

# 분석할 종목 목록입니다. 쉼표로 구분합니다.
STOCK_LIST=005930,000660,035420,AAPL,TSLA,NVDA

# ===================================
# 데이터 제공자
# ===================================
# 한국 주식은 pykrx, 미국 주식은 yfinance 경로를 사용합니다.

# ===================================
# AI 모델 설정
# ===================================
# 자세한 설명은 docs/LLM_CONFIG_GUIDE.md를 참고하세요.
# 단일 모델은 API Key만 입력하면 됩니다.

GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_TEMPERATURE=0.7

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0.7

# ANTHROPIC_API_KEY=
# ANTHROPIC_TEMPERATURE=0.7

# LiteLLM 모델 이름은 provider/model 형식을 권장합니다.
# LITELLM_MODEL=gemini/gemini-2.5-flash
# LITELLM_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3-5-sonnet-20241022

# 여러 채널을 분리해서 운영할 때 사용합니다.
# LLM_CHANNELS=gemini,openai
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini/gemini-2.5-flash
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_MODELS=gpt-4o-mini

# 표준 LiteLLM YAML을 사용할 때 설정합니다.
# LITELLM_CONFIG=./litellm_config.yaml

# 이미지에서 종목 코드를 추출할 때 사용할 Vision 모델입니다.
# VISION_MODEL=gemini/gemini-2.0-flash
# VISION_PROVIDER_PRIORITY=gemini,anthropic,openai

# ===================================
# 뉴스 검색
# ===================================
# 한국 뉴스 검색에는 Naver Search를 사용합니다.
# 형식: client_id:client_secret, 여러 개는 쉼표로 구분합니다.
NAVER_API_KEYS=

# 글로벌 뉴스 검색은 아래 서비스 중 하나 이상을 설정합니다.
TAVILY_API_KEYS=
BRAVE_API_KEYS=
SERPAPI_API_KEYS=

# 뉴스 최대 허용 기간입니다.
# NEWS_MAX_AGE_DAYS=3

# ===================================
# 알림 채널
# ===================================
# 필요한 채널만 값을 입력하세요.

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=

# Discord
# DISCORD_WEBHOOK_URL=
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=

# Email
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=
# STOCK_GROUP_1=005930,000660
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=AAPL,TSLA
# EMAIL_GROUP_2=user2@example.com

# Pushover
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=

# Custom Webhook
# CUSTOM_WEBHOOK_URLS=
# CUSTOM_WEBHOOK_BEARER_TOKEN=
# WEBHOOK_VERIFY_SSL=true

# AstrBot
# ASTRBOT_URL=
# ASTRBOT_TOKEN=

# Markdown 리포트를 이미지로 변환할 채널입니다.
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,discord,custom,email
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000
# MD2IMG_ENGINE=wkhtmltoimage

# 단일 종목 분석이 끝날 때마다 바로 알림을 보냅니다.
# SINGLE_STOCK_NOTIFY=false
# REPORT_TYPE=simple
# REPORT_SUMMARY_ONLY=false
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# Agent 전략 대화
# ===================================
AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,shrink_pullback
# AGENT_MODE=true
# AGENT_MAX_STEPS=10
# AGENT_STRATEGY_DIR=./strategies

# ===================================
# 백테스트
# ===================================
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=10
BACKTEST_MIN_AGE_DAYS=14
BACKTEST_ENGINE_VERSION=v1
BACKTEST_NEUTRAL_BAND_PCT=2.0

# ===================================
# 실행 일정
# ===================================
SCHEDULE_ENABLED=false
SCHEDULE_TIME=18:00
RUN_IMMEDIATELY=true
MARKET_REVIEW_ENABLED=true
# MARKET_REVIEW_REGION=both
# TRADING_DAY_CHECK_ENABLED=true

# ===================================
# WebUI
# ===================================
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
WEBUI_AUTO_BUILD=true
# TRUST_X_FORWARDED_FOR=false

# Web 로그인 인증입니다.
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24

# ===================================
# 저장소와 로그
# ===================================
DATABASE_PATH=./data/stock_analysis.db
LOG_DIR=./logs
LOG_LEVEL=INFO
MAX_WORKERS=3
DEBUG=false

# ===================================
# 프록시
# ===================================
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=10809

# ===================================
# 분석 옵션
# ===================================
# 개별 종목 분석 사이의 대기 시간입니다.
# ANALYSIS_DELAY=0
# BIAS_THRESHOLD=5.0
# ENABLE_REALTIME_QUOTE=true
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true
